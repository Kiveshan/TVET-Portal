# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=4000

# Hosted only. Number of proxies in front of the app (1 behind a load balancer).
# TRUST_PROXY=1
# Hosted only. Serve the built frontend from here (the Docker image sets /app/public).
# STATIC_DIR=../frontend/dist

# Read access to the S3 ingestion bucket (Parquet submissions shown on the dashboard).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=af-south-1
INGESTION_BUCKET=dhet-ingestion-landing-515966540182
# Rows DHET approves are written here (needs write access).
APPROVED_BUCKET=dhet-approved
